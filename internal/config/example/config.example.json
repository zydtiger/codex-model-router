    "models": [
      {
        "id": "qwen3-32b",
        "route": "sglang",
        "display_name": "Qwen3 32B (local)",
        "context_window": 131072,
        "input_modalities": ["text"],
        "reasoning_levels": ["none", "low", "medium", "high"],
        "default_reasoning_level": "medium",
        "tool_capable": true
      }
    ]
  }
