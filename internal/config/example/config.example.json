{
  "listen": {
    "host": "127.0.0.1",
    "port": 4317
  },
  "base_path": "/v1",
  "max_request_bytes": 33554432,
  "log": {
    "level": "warn",
    "requests": false
  },
  "native": {
    "chatgpt_base_url": "https://chatgpt.com/backend-api/codex",
